# Copy to /etc/proxy-dispatcher/proxy-dispatcher.env and chmod 600.
# The management service stays on loopback; put Nginx/HTTPS in front of it.
NODE_ENV=production
SERVER_MODE=1
HOST=127.0.0.1
PORT=4173

# Public proxy listeners. Every listener still has its own generated username/password.
PROXY_LISTEN=0.0.0.0
PROXY_PORT_MIN=21000
PROXY_PORT_MAX=21250
MAX_ACTIVE_NODES=200

STATE_FILE=/var/lib/proxy-dispatcher/data/state.json
ACTIVE_BRIDGES_FILE=/var/lib/proxy-dispatcher/data/active-bridges.json
SETTINGS_FILE=/var/lib/proxy-dispatcher/data/settings.json
MIHOMO_PATH=/opt/proxy-dispatcher/bin/mihomo

